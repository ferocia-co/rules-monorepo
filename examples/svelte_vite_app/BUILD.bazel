load("@npm//examples/svelte_vite_app:eslint/package_json.bzl", eslint_bin = "bin")
load("@npm//examples/svelte_vite_app:playwright/package_json.bzl", playwright_bin = "bin")
load("@npm//examples/svelte_vite_app:prettier/package_json.bzl", prettier_bin = "bin")
load("@npm//examples/svelte_vite_app:svelte-check/package_json.bzl", svelte_check_bin = "bin")
load("@npm//examples/svelte_vite_app:typescript/package_json.bzl", tsc_bin = "bin")
load("@npm//examples/svelte_vite_app:vite/package_json.bzl", vite_bin = "bin")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_monorepo//rules_monorepo_frontend:defs.bzl", "frontend_static_site_oci_image", "pnpm_frontend_checks", "pnpm_playwright_cli", "pnpm_playwright_test", "pnpm_svelte_vite_app")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages()

APP_SRCS = glob(
    [
        "eslint.config.mjs",
        "index.html",
        "nginx.conf",
        "package.json",
        "pnpm-workspace.yaml",
        "prettier.config.mjs",
        "src/**",
        "tests/**",
        "tsconfig.json",
        "vite.config.ts",
    ],
    exclude = [
        "dist/**",
        "node_modules/**",
        "test-results/**",
    ],
)

filegroup(
    name = "sources",
    srcs = APP_SRCS,
)

pnpm_svelte_vite_app(
    name = "bundle",
    vite = vite_bin.vite,
    srcs = APP_SRCS,
)

pnpm_frontend_checks(
    name = "checks",
    srcs = APP_SRCS,
    eslint = eslint_bin.eslint,
    prettier = prettier_bin.prettier,
    svelte_check = svelte_check_bin.svelte_check,
    tsc = tsc_bin.tsc,
)

pnpm_playwright_cli(
    name = "playwright_cli",
    playwright = playwright_bin.playwright_binary,
)

pnpm_playwright_test(
    name = "playwright_test",
    entry_point = "tests/smoke.mjs",
    srcs = APP_SRCS,
)

frontend_static_site_oci_image(
    name = "frontend",
    assets = ":bundle",
    nginx_conf = "nginx.conf",
    repo_tags = ["svelte-vite-app:local"],
    repository = "registry.example.com/svelte-vite-app",
)
