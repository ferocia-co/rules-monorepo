load(":executable_file.bzl", "executable_file")

package(default_visibility = ["//visibility:public"])

exports_files([
    "README.md",
    "executable_file.bzl",
])

config_setting(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
)

config_setting(
    name = "darwin_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

alias(
    name = "cargo",
    actual = "@rules_rust//tools/upstream_wrapper:cargo",
)

alias(
    name = "rust_analyzer_setup",
    actual = "@rules_rust//tools/rust_analyzer:setup",
)

executable_file(
    name = "cargo_audit",
    src = select({
        ":darwin_arm64": "@cargo_audit_darwin_arm64//:cargo-audit",
        ":darwin_amd64": "@cargo_audit_darwin_amd64//:cargo-audit",
        ":linux_arm64": "@cargo_audit_linux_arm64//:cargo-audit",
        ":linux_amd64": "@cargo_audit_linux_amd64//:cargo-audit",
    }),
)
