+                JsonValue::Null => Value::Null,
+                JsonValue::Boolean(value) => Value::Bool(value),
+                JsonValue::Number(value) => serde_json::from_str(value).unwrap(),
+                JsonValue::String(value) => Value::String(value.into_owned()),
+                JsonValue::Array(value) => {
+                    Value::Array(value.into_iter().map(into_serde).collect())
+                }
+                JsonValue::Object(value) => Value::Object(
+                    value
+                        .into_iter()
+                        .map(|(key, value)| (key, into_serde(value)))
+                        .collect(),
+                ),
+            }
+        }
