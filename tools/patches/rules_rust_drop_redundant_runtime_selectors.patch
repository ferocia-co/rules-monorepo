+def _get_rustc_linker_args(linker_config):
+    # rustc passes -nodefaultlibs and receives the runtime archives
+    # explicitly, so Clang cannot use these CC driver selectors.
+    # Preserve the selectors for native Cargo build-script LDFLAGS.
+    return [
+        arg
+        for arg in _get_linker_args(linker_config)
+        if arg not in ("-rtlib=compiler-rt", "--unwindlib=none")
+    ]
 
