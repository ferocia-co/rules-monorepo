load("@rules_monorepo//rules_monorepo_rust:defs.bzl", "rust_binary", "rust_test")
load(":defs_test.bzl", "zkvm_rule_tests")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "defs_test.bzl",
    "extensions.bzl",
    "repositories.bzl",
    "LICENSE.risc0",
    "NOTICE.risc0",
    "private/risc0_cc_toolchain_config.bzl",
    "private/support.bzl",
    "private/zkvm_hub.BUILD.tpl",
])

constraint_setting(name = "proof_system")

constraint_value(
    name = "risc0",
    constraint_setting = ":proof_system",
)

constraint_value(
    name = "sp1",
    constraint_setting = ":proof_system",
)

platform(
    name = "risc0_guest_platform",
    constraint_values = [
        ":risc0",
        "@platforms//cpu:riscv32",
        "@platforms//os:none",
    ],
)

toolchain_type(name = "risc0_support_toolchain_type")

platform(
    name = "sp1_guest_platform",
    constraint_values = [
        ":sp1",
        "@platforms//cpu:riscv32",
        "@platforms//os:none",
    ],
)

# An analysis-only execution platform for developers on non-Linux hosts. Pass
# it with --extra_execution_platforms and --nobuild; executable guest actions
# remain supported only by real Linux x86_64 workers.
platform(
    name = "linux_x86_64_exec_platform",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

rust_binary(
    name = "risc0_program_binary",
    srcs = ["private/risc0_program_binary.rs"],
    crate_name = "risc0_program_binary",
    edition = "2024",
)

rust_test(
    name = "risc0_program_binary_test",
    srcs = ["private/risc0_program_binary.rs"],
    compile_data = ["private/testdata/program_binary_3_0_5.hex"],
    crate_name = "risc0_program_binary_test",
    edition = "2024",
)

zkvm_rule_tests()
