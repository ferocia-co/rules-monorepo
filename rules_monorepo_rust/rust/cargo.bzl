def _sanitize_target_name(value):
    sanitized = value
    for ch in ["/", "\\", ".", "-", ":", "@"]:
        sanitized = sanitized.replace(ch, "_")
    return sanitized

def cargo_rust_test_suite(
        name,
        srcs,
        shared_srcs = None,
        tags = None,
        visibility = None,
        testonly = None,
        **kwargs):
    """Creates one Cargo-inferred rust_test per integration-test source."""
    shared_srcs = list(shared_srcs or [])
    shared_srcs_set = {src: True for src in shared_srcs}
    test_tags = list(tags or [])
    generated_tests = []

    for src in srcs:
        if type(src) != "string":
            fail("cargo_rust_test_suite only supports string labels, got {}".format(src))
        if src in shared_srcs_set or not src.endswith(".rs"):
            continue

        target = "{}__{}".format(name, _sanitize_target_name(src))
        cargo_rust_test(
            name = target,
            srcs = [src] + shared_srcs,
            tags = test_tags,
            **kwargs
        )
        generated_tests.append(":" + target)

    if not generated_tests:
        fail("cargo_rust_test_suite({}, ...) found no Rust test sources".format(name))

    suite_kwargs = {
        "name": name,
        "tests": generated_tests,
        "tags": test_tags,
    }
    if visibility != None:
        suite_kwargs["visibility"] = visibility
    if testonly != None:
        suite_kwargs["testonly"] = testonly
    native.test_suite(**suite_kwargs)
